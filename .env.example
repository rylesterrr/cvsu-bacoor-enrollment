# Copy this file to .env and adjust the values for your machine.
# Generate a new secret key for anything beyond local development:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection used by the app.
# Create the database/user first (see README.md), then update the password.
DATABASE_URL=postgres://enrollment:enrollment@localhost:5432/enrollment
